# Credenciales ficticias: uso exclusivo del laboratorio local.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_EC2_METADATA_DISABLED=true

# El puerto 4566 se publica solo en loopback; para verlo desde otro equipo usar
# un túnel SSH. El túnel de Cloudflare solo publica la API y el frontend.

# deploy:local obtiene la ruta de API de los outputs y la pasa al build.
# VITE_API_BASE_URL=http://127.0.0.1:4566/_aws/execute-api/<api-id>/local

# Configuración de aplicación que se publica en LocalEmu Secrets Manager.
# El script de despliegue la lee de .env; aquí solo hay valores de ejemplo.
TABLE_NAME=heraap-registros-local
DYNAMODB_ENDPOINT_URL=http://localemu:4566
DB_HOST=172.18.0.1
DB_PORT=5432
DB_NAME=heraap
DB_USER=heraap
DB_PASSWORD=genera-una-con-openssl-rand-hex-24
SECRET_ID=heraap/config

# Acceso con Google. Crear un cliente OAuth 2.0 (tipo "aplicación web") en
# Google Cloud y autorizar exactamente la URI del callback del backend,
# cambiando <API_ID> por el valor de ApiId del despliegue.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=https://local.deptofeliz.uk/_aws/execute-api/<API_ID>/local/auth/google/callback
# Debe incluir index.html: LocalEmu devuelve el listado del bucket en la ruta raíz.
FRONTEND_URL=https://local.deptofeliz.uk/heraap-frontend-local/index.html
